{
  "schemaVersion": 1,
  "id": "otzaria-open-plus",
  "name": "פתיחת ספרייה",
  "version": "0.3.0",
  "description": "כפתור + פותח את הספרייה המקורית; ניתן להפעיל ולכבות אותו מתוך התוסף.",
  "author": "אברהם mch",
  "homepage": "https://github.com/avtsye/Otzaria-Open-Plus",
  "entrypoint": "index.html",
  "minAppVersion": "0.9.98",
  "sdkVersion": "1.x",
  "stability": "experimental",
  "permissions": [
    "navigation.write",
    "reader.open",
    "plugin.storage.read",
    "plugin.storage.write",
    "app.run_on_startup",
    "app.startup_contributions",
    "events.subscribe:theme.changed"
  ],
  "contributes": {
    "background": {
      "entrypoint": "background.html"
    },
    "toolTab": {
      "title": "פתיחת ספרייה",
      "iconName": "book_open_medium_lines_24_filled",
      "defaultPinned": true
    },
    "startup": {
      "activationEvents": [
        "app.startup"
      ]
    }
  }
}
